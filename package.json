    "vue-template-compiler": "^2.6.10",
    "webpack": "^5.90.1"
  },
  "dependencies": {
    "bootbox": "^5.3.2",
    "bootstrap": "^4.3.1",
    "bootstrap-select": "^1.13.10",
    "bootstrap-slider": "^10.6.2",
    "chart.js": "^2.8.0",
    "icheck": "^1.0.2",
